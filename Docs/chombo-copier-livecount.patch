diff --git a/lib/src/BoxTools/Copier.H b/lib/src/BoxTools/Copier.H
index b200ce5..f4f51ac 100644
--- a/lib/src/BoxTools/Copier.H
+++ b/lib/src/BoxTools/Copier.H
@@ -155,7 +155,16 @@ public:
 
   ///null constructor, copy constructor and operator= can be compiler defined.
   Copier():m_isDefined(false)
-  {}
+  {
+    s_liveCopiers++;
+  }
+
+  /**
+     DIAGNOSTIC. Copiers constructed minus Copiers destroyed. A Copier owns its motion plan --
+     MotionItems plus the per-rank index vectors -- so a live count that climbs from one regrid to
+     the next means those plans are being retained, and the layouts they refer to with them.
+  */
+  static long long s_liveCopiers;
 
   Copier(const Copier& a_rhs);
 
