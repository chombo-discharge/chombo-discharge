# ====================================================================================================
# ItoSolver class options
# ====================================================================================================
ItoSolver.verbosity                 = -1             ## Class verbosity
# Super-particle merging. The method names the scope the merge groups particles over; how it groups
# within that scope is set by the kd_* or nn_* specifiers below.
ItoSolver.particles_per_cell        = 32             ## Target computational particles per cell (one value, or one per level)
ItoSolver.merge_method              = kd_cell        ## Merge scope. One of 'kd_cell', 'kd_patch', 'kd_amr', 'nn_amr', 'reinitialize', 'none', or 'external'
ItoSolver.regrid_superparticles     = solver         ## Merge run during regrids: 'solver' (use merge_method), 'none', or any merge_method selector
# kd_cell/kd_patch/kd_amr specifiers.
ItoSolver.kd_partition              = weight         ## Split rule: 'weight', 'count', or 'hybrid' (count median above kd_hybrid_leaf_dx, weight median below)
ItoSolver.kd_hybrid_leaf_dx         = 1.0            ## kd_partition = hybrid: node size (cell widths) at which the split switches to the weight median
ItoSolver.kd_placement              = centroid       ## Leaf placement: 'centroid', 'sample' (weight-sampled member) or 'random' (uniform in the leaf box)
ItoSolver.kd_amr_boundary           = carve          ## kd_amr: boundary tier -- 'carve' (arbitrated) or 'nn' (nearest-neighbour skin)
# nn_amr specifiers. Also read by kd_amr with kd_amr_boundary = nn, whose skin tier is a nn merge.
ItoSolver.nn_search                 = tree           ## nn_amr: neighbour search -- 'tree', 'hash' or 'onecell'
ItoSolver.nn_iterate                = true           ## Iterate the local tier to convergence within each round
ItoSolver.nn_fallback               = 1              ## Fallback candidates per query
ItoSolver.nn_max_cell_dist          = 1              ## Max merge distance in cells (Chebyshev); unused by nn_search = onecell (fixed at 1)
ItoSolver.nn_max_rounds             = 3              ## Max drain rounds per merge (stops early on convergence)
ItoSolver.plt_vars                  = phi vel dco    ## 'phi', 'vel', 'dco', 'grad_dco', 'part', 'eb_part', 'dom_part', 'src_part', 'energy_density', 'energy'
ItoSolver.intersection_alg          = bisection      ## Intersection algorithm for EB-particle intersections.
ItoSolver.bisect_step               = 1.E-4          ## Bisection step length for intersection tests
ItoSolver.normal_max                = 5.0            ## Maximum value (absolute) that can be drawn from the exponential distribution.
ItoSolver.diffusion_grad_drift      = true           ## Add grad(D) to the drift so the particles transport D*grad(n), as CdrSolver does
ItoSolver.checkpointing             = particles      ## 'particles' or 'numbers'
ItoSolver.ppc_restart               = 32             ## Particles per cell redrawn when restarting from a 'checkpointing = numbers' checkpoint
ItoSolver.irr_ngp_interp            = true           ## Force irregular interpolation in cut cells or not
ItoSolver.mobility_interp           = direct         ## How to interpolate mobility, 'direct' or 'velocity', i.e. either mu_p = mu(X_p) or mu_p = (mu*E)(X_p)/E(X_p)
ItoSolver.plot_deposition           = cic            ## Cloud-in-cell for plotting particles.
ItoSolver.deposition                = cic            ## Deposition type.
ItoSolver.deposition_irreg          = mirror         ## Cut-cell deposition: 'native', 'ngp', 'mirror', 'redistribute', 'redistribute_blended'
ItoSolver.deposition_cf             = transition     ## 'interp', 'halo', 'halo_ngp', 'transition'.
