{
    "//comment": [
        "Minimal stiff two-group model. All rates are constants, so no data files are needed.",
        "  e  -> el + el + M+   at 7.468e9  1/s     (fast species produced by a slow reaction)",
        "  el -> e              at 1.741e11 1/s     (fast relaxation, 23x the ionization rate)",
        "The electron total is e + el and grows at 6.900e9 1/s, the dominant eigenvalue of",
        "  [ -nu_i  nu_r ; 2 nu_i  -nu_r ]."
    ],
    "gas": {
        "background species": [
            { "id": "M", "molar fraction": { "type": "constant", "value": 1.0 } }
        ],
        "law": {
            "id": "ideal_gas",
            "plot": false,
            "ideal_gas": { "type": "ideal", "temperature": 300, "pressure": 0.233E5 }
        }
    },
    "particle placement": { "method": "random", "species": "e" },
    "alpha": { "type": "constant", "value": 0.0 },
    "eta":   { "type": "constant", "value": 0.0 },
    "plasma species": [
        { "id": "e",  "Z": -1, "solver": "ito", "mobile": false, "diffusive": false, "initial density": 0.0 },
        { "id": "el", "Z": -1, "solver": "ito", "mobile": false, "diffusive": false, "initial density": 0.0 },
        { "id": "M+", "Z":  1, "solver": "cdr", "mobile": false, "diffusive": false, "initial density": 0.0 }
    ],
    "photon species": [],
    "plasma reactions": [
        {
            "reaction": "e -> el + el + M+",
            "description": "slow branching reaction, produces the fast species",
            "type": "constant",
            "value": 7.468E9,
            "include_dt_calc": true
        },
        {
            "reaction": "el -> e",
            "description": "fast relaxation",
            "type": "constant",
            "value": 1.741E11,
            "include_dt_calc": true
        }
    ],
    "photoionization": []
}
