# ====================================================================================================
# AmrMesh class options
# ====================================================================================================
AmrMesh.lo_corner               = -1 -1 -1       ## Low corner of problem domain
AmrMesh.hi_corner               = 1  1  1        ## High corner of problem domain
AmrMesh.verbosity               = -1             ## Controls verbosity.
AmrMesh.coarsest_domain         = 32 32          ## Number of cells on coarsest domain
AmrMesh.max_amr_depth           = 2              ## Maximum amr depth
AmrMesh.max_sim_depth           = -1             ## Maximum simulation depth
AmrMesh.fill_ratio              = 1.0            ## Fill ratio for grid generation
AmrMesh.buffer_size             = 2              ## Number of cells between grid levels
AmrMesh.grid_algorithm          = tiled          ## Berger-Rigoustous 'br' or 'tiled' for the tiled algorithm
AmrMesh.box_sorting             = morton         ## 'none', 'shuffle', 'morton'
AmrMesh.min_block_size          = 8              ## Minimum block size (smallest box / tile size)
AmrMesh.max_block_size          = 8              ## Maximum allowed box size
AmrMesh.max_ebis_box            = 8              ## Maximum allowed box size for EBIS generation.
AmrMesh.ref_rat                 = 2 2 2 2 2 2    ## Refinement ratios (mixed ratios are allowed).
AmrMesh.num_ghost               = 2              ## Number of ghost cells.
AmrMesh.lsf_ghost               = 2              ## Number of ghost cells when writing level-set to grid
AmrMesh.eb_ghost                = 2              ## Set number of of ghost cells for EB stuff
AmrMesh.mg_interp_order         = 2              ## Multigrid interpolation order
AmrMesh.mg_interp_radius        = 2              ## Multigrid interpolation radius
AmrMesh.mg_interp_weight        = 1              ## Multigrid interpolation weight (for least squares)
AmrMesh.centroid_interp         = minmod         ## Centroid interp stencils. linear, lsq, minmod, etc
AmrMesh.eb_interp               = minmod         ## EB interp stencils. linear, taylor, minmod, etc
AmrMesh.redist_radius           = 1              ## Redistribution radius for hyperbolic conservation laws
AmrMesh.mirror_band_radius      = 2              ## Mirror deposition: band half-width in cells. Requires num_ghost >= this.
AmrMesh.mirror_cond_tol         = 1.E-3          ## Mirror deposition: min eigenvalue ratio of U^T U in the curvature fit.
AmrMesh.mirror_crease_tol       = 1.E-1          ## Mirror deposition: max dimensionless fit residual before falling back to J = 1.
AmrMesh.mirror_max_jacobian     = 1.E4           ## Mirror deposition: refuse (J = 1) above this. Must exceed ~500.
AmrMesh.mirror_min_denom        = 1.E-4          ## Mirror deposition: refuse (J = 1) below this. Must be under ~4E-3.

# ====================================================================================================
# Driver class options
# ====================================================================================================
Driver.verbosity                    = 2                   ## Driver verbosity.
Driver.geometry_generation          = chombo-discharge    ## Grid generation method, 'chombo-discharge' or 'chombo'
Driver.geometry_scan_level          = 0                   ## Geometry scan level for chombo-discharge geometry generator
Driver.ebis_memory_load_balance     = false               ## If using Chombo geo-gen, use memory as loads for EBIS generation
Driver.output_dt                    = -1.0                ## Output interval (values <= 0 enforces step-based output)
Driver.plot_interval                = 10                  ## Plot interval
Driver.checkpoint_interval          = -1                  ## Checkpoint interval
Driver.regrid_interval              = 5                   ## Regrid interval
Driver.write_regrid_files           = false               ## Write or do not write plot files during regrids.
Driver.write_restart_files          = false               ## Write or do not write plot files during restart or not.
Driver.initial_regrids              = 1                   ## Number of initial regrids.
Driver.do_init_load_balance         = false               ## If true, load balance the first step in a fresh simulation.
Driver.start_time                   = 0                   ## Start time (fresh simulations only).
Driver.stop_time                    = 1.E10               ## Stop time.
Driver.max_steps                    = 10                  ## Maximum number of steps.
Driver.geometry_only                = false               ## Special option that ONLY plots the geometry.
Driver.write_memory                 = false               ## Write MPI memory report.
Driver.write_loads                  = false               ## Write (accumulated) computational loads.
Driver.output_directory             = ./                  ## Output directory.
Driver.output_names                 = simulation          ## Simulation output names.
Driver.max_plot_depth               = -1                  ## Restrict maximum plot depth (-1 => finest simulation level).
Driver.max_chk_depth                = -1                  ## Restrict checkpoint depth (-1 => finest simulation level).
Driver.num_plot_ghost               = 1                   ## Number of ghost cells to include in plots.
Driver.plt_vars                     = levelset            ## 'tags', 'mpi_rank', 'levelset', 'loads'.
Driver.restart                      = 0                   ## Restart step (less or equal to 0 implies fresh simulation).
Driver.allow_coarsening             = true                ## Allows removal of grid levels according to CellTagger.
Driver.grow_geo_tags                = 2                   ## How much to grow tags when using geometry-based refinement.
Driver.refine_angles                = 15.                 ## Refine cells if angle between elements exceed this value.
Driver.refine_electrodes            = 0                   ## Refine electrode surfaces to specified level ( < 0 will refine everything)
Driver.refine_dielectrics           = 0                   ## Refine dielectric surfaces to specified level ( < 0 will refine everything)

# ====================================================================================================
# ItoSolver class options
# ====================================================================================================
ItoSolver.verbosity                 = -1             ## Class verbosity
# Super-particle merging. The method names the scope the merge groups particles over; how it groups
# within that scope is set by the kd_* or nn_* specifiers below.
ItoSolver.particles_per_cell        = 16             ## Target computational particles per cell (one value, or one per level)
ItoSolver.merge_method              = kd_cell        ## Merge scope. One of 'kd_cell', 'kd_patch', 'kd_amr', 'nn_amr', 'reinitialize', 'none', or 'external'
ItoSolver.regrid_superparticles     = solver         ## Merge run during regrids: 'solver' (use merge_method), 'none', or any merge_method selector
# kd_cell/kd_patch/kd_amr specifiers.
ItoSolver.kd_partition              = count          ## Split rule: 'weight', 'count', or 'hybrid' (count median above kd_hybrid_leaf_dx, weight median below)
ItoSolver.kd_hybrid_leaf_dx         = 1.0            ## kd_partition = hybrid: node size (cell widths) at which the split switches to the weight median
ItoSolver.kd_placement              = centroid       ## Leaf placement: 'centroid', 'sample' (weight-sampled member) or 'random' (uniform in the leaf box)
ItoSolver.kd_amr_boundary           = carve          ## kd_amr: boundary tier -- 'carve' (arbitrated) or 'nn' (nearest-neighbour skin)
# nn_amr specifiers. Also read by kd_amr with kd_amr_boundary = nn, whose skin tier is a nn merge.
ItoSolver.nn_search                 = tree           ## nn_amr: neighbour search -- 'tree', 'hash' or 'onecell'
ItoSolver.nn_iterate                = true           ## Iterate the local tier to convergence within each round
ItoSolver.nn_fallback               = 1              ## Fallback candidates per query
ItoSolver.nn_max_cell_dist          = 1              ## Max merge distance in cells (Chebyshev); unused by nn_search = onecell (fixed at 1)
ItoSolver.nn_max_rounds             = 3              ## Max drain rounds per merge (stops early on convergence)
ItoSolver.plt_vars                  = phi vel dco    ## 'phi', 'vel', 'dco', 'grad_dco', 'part', 'eb_part', 'dom_part', 'src_part', 'energy_density', 'energy'
ItoSolver.intersection_alg          = bisection      ## Intersection algorithm for EB-particle intersections.
ItoSolver.bisect_step               = 1.E-4          ## Bisection step length for intersection tests
ItoSolver.normal_max                = 5.0            ## Maximum value (absolute) that can be drawn from the exponential distribution.
ItoSolver.diffusion_grad_drift      = true           ## Add grad(D) to the drift so the particles transport D*grad(n), as CdrSolver does
ItoSolver.checkpointing             = particles      ## 'particles' or 'numbers'
ItoSolver.ppc_restart               = 32             ## Particles per cell redrawn when restarting from a 'checkpointing = numbers' checkpoint
ItoSolver.irr_ngp_interp            = true           ## Force irregular interpolation in cut cells or not
ItoSolver.mobility_interp           = direct         ## How to interpolate mobility, 'direct' or 'velocity', i.e. either mu_p = mu(X_p) or mu_p = (mu*E)(X_p)/E(X_p)
ItoSolver.plot_deposition           = cic            ## Cloud-in-cell for plotting particles.
ItoSolver.deposition                = cic            ## Deposition type.
ItoSolver.deposition_irreg          = native         ## Cut-cell deposition: 'native', 'ngp', 'mirror', 'redistribute', 'redistribute_blended'
ItoSolver.deposition_cf             = transition     ## 'interp', 'halo', 'halo_ngp', 'transition'.

# ====================================================================================================
# ParticleMergeStepper class options
# ====================================================================================================
ParticleMergeStepper.verbosity               = -1        ## Verbosity
ParticleMergeStepper.realm                   = primal    ## Realm
ParticleMergeStepper.diffusion               = false     ## Turn on/off diffusion
ParticleMergeStepper.advection               = true      ## Turn on/off advection
ParticleMergeStepper.blob_amplitude          = 1.0       ## Blob amplitude
ParticleMergeStepper.blob_radius             = 0.1       ## Blob radius
ParticleMergeStepper.blob_center             = 0 0       ## Blob center
ParticleMergeStepper.seed                    = 0         ## RNG seed
ParticleMergeStepper.num_particles           = 0         ## Number of initial particles
ParticleMergeStepper.cfl                     = 0.5       ## CFL-like number.
ParticleMergeStepper.load_balance            = true      ## Turn on/off particle load balancing
ParticleMergeStepper.which_balance           = mesh      ## Switch for load balancing method. Either 'mesh' or 'particle'.
ParticleMergeStepper.verify_conservation     = false     ## Abort if a superparticle merge does not conserve total weight
ParticleMergeStepper.plot_particles          = true      ## Write the bulk particles to H5Part on every plot step

# Velocity, diffusion, and CFL
# ----------------------------
ParticleMergeStepper.mobility              = 1.0         ## Mobility coefficient
ParticleMergeStepper.diffco                = 1.0         ## Diffusion coefficient
ParticleMergeStepper.omega                 = 1.0         ## Rotation velocity for advection field (velocity_field = rotational)
ParticleMergeStepper.velocity_field        = constant    ## Advective field. 'rotational' (uses omega) or 'constant' (uses constant_velocity)
ParticleMergeStepper.constant_velocity     = 0 1 0       ## Advective field when velocity_field = constant

# Cell tagging stuff
# ------------------
ParticleMergeStepper.refine_curv     = 0.1     ## Refine if curvature exceeds this
ParticleMergeStepper.refine_magn     = 1E-2    ## Only tag if magnitude eceeds this
ParticleMergeStepper.buffer          = 0       ## Grow tagged cells

# Particle seeding and reporting
# ------------------------------
ParticleMergeStepper.new_particles_per_cell     = 32       ## Particles seeded per cell before every advance
ParticleMergeStepper.print_stats                = false    ## Print per-level merge statistics to pout every step

# ====================================================================================================
# ParticleMergeTagger class options
# ====================================================================================================
ParticleMergeTagger.buffer            = 0                 ## Grow the tagged region by this many cells
ParticleMergeTagger.num_ref_boxes     = 1                 ## Number of manual refinement boxes
ParticleMergeTagger.ref_box1_lo       = -1.0 -0.1 -1.0    ## Lower corner of refinement box 1
ParticleMergeTagger.ref_box1_hi       = 1.0  0.1  1.0     ## Upper corner of refinement box 1
ParticleMergeTagger.ref_box1_lvl      = 2                 ## Refine box 1 to this level
