# ====================================================================================================
# AMR_MESH OPTIONS
# ====================================================================================================
AmrMesh.lo_corner               = -2 -2 -2       ## Low corner of problem domain
AmrMesh.hi_corner               = 2  2  2        ## High corner of problem domain
AmrMesh.verbosity               = -1             ## Controls verbosity.
AmrMesh.coarsest_domain         = 32 32 32       ## Number of cells on coarsest domain
AmrMesh.max_amr_depth           = 2              ## Maximum amr depth
AmrMesh.max_sim_depth           = -1             ## Maximum simulation depth
AmrMesh.fill_ratio              = 1.0            ## Fill ratio for grid generation
AmrMesh.buffer_size             = 2              ## Number of cells between grid levels
AmrMesh.grid_algorithm          = br             ## Berger-Rigoustous 'br' or 'tiled' for the tiled algorithm
AmrMesh.box_sorting             = morton         ## Box sorting
AmrMesh.min_block_size          = 8              ## Default blocking factor (16 in 3D)
AmrMesh.max_block_size          = 16             ## Maximum allowed box size
AmrMesh.max_ebis_box            = 16             ## Maximum allowed box size
AmrMesh.eb_min_block_size       = 8              ## Smallest box the geometry grids are tiled with.
AmrMesh.eb_max_block_size       = 8              ## Largest such box, a whole number of eb_min_block_size.
AmrMesh.ref_rat                 = 2 2 2 2 2 2    ## Refinement ratios
AmrMesh.lsf_ghost               = 2              ## Number of ghost cells when writing level-set to grid
AmrMesh.num_ghost               = 2              ## Number of ghost cells. Default is 3
AmrMesh.eb_ghost                = 4              ## Set number of of ghost cells for EB stuff
AmrMesh.mg_interp_order         = 2              ## Multigrid interpolation order
AmrMesh.mg_interp_radius        = 2              ## Multigrid interpolation radius
AmrMesh.mg_interp_weight        = 2              ## Multigrid interpolation weight (for least squares)
AmrMesh.centroid_interp         = minmod         ## Centroid interp stencils. linear, lsq, minmod, etc
AmrMesh.eb_interp               = minmod         ## EB interp stencils. linear, taylor, minmod, etc
AmrMesh.srd_order               = 2              ## State redistribution: reconstruction order, 0 (constant) or 2 (linear, limited)
AmrMesh.srd_target_volfrac      = 0.5            ## State redistribution: cut cells with smaller volume fractions are merged
AmrMesh.mirror_band_radius      = 2              ## Mirror deposition: band half-width in cells. Requires num_ghost >= this.
AmrMesh.mirror_cond_tol         = 1.E-3          ## Mirror deposition: min eigenvalue ratio of U^T U in the curvature fit.
AmrMesh.mirror_crease_tol       = 1.E-1          ## Mirror deposition: max dimensionless fit residual before falling back to J = 1.
AmrMesh.mirror_max_jacobian     = 1.E4           ## Mirror deposition: refuse (J = 1) above this. Must exceed ~500.
AmrMesh.mirror_min_denom        = 1.E-4          ## Mirror deposition: refuse (J = 1) below this. Must be under ~4E-3.
AmrMesh.load_balance            = volume         ## Load balancing algorithm. Valid options are 'volume' or 'elliptic'

# ====================================================================================================
# DRIVER OPTIONS
# ====================================================================================================
Driver.verbosity                    = 3                   ## Engine verbosity
Driver.geometry_generation          = chombo-discharge    ## Grid generation method, 'chombo-discharge' or 'chombo'
Driver.geometry_scan_level          = 0                   ## Geometry scan level for chombo-discharge geometry generator
Driver.plot_interval                = 10                  ## Plot interval
Driver.regrid_interval              = -1                  ## Regrid interval
Driver.checkpoint_interval          = -1                  ## Checkpoint interval
Driver.write_regrid_files           = false               ## Write regrid files or not.
Driver.write_restart_files          = false               ## Write restart files or not
Driver.initial_regrids              = 2                   ## Number of initial regrids
Driver.do_init_load_balance         = false               ## If true, load balance the first step in a fresh simulation.
Driver.start_time                   = 0                   ## Start time (fresh simulations only)
Driver.stop_time                    = 1.0                 ## Stop time
Driver.max_steps                    = 1000                ## Maximum number of steps
Driver.geometry_only                = false               ## Special option that ONLY plots the geometry
Driver.ebis_memory_load_balance     = false               ## Use memory as loads for EBIS generation
Driver.output_dt                    = -1.0                ## Output interval (values <= 0 enforces step-based output)
Driver.write_memory                 = false               ## Write MPI memory report
Driver.write_loads                  = false               ## Write (accumulated) computational loads
Driver.output_directory             = ./                  ## Output directory
Driver.output_names                 = RadialOutflow3d     ## Simulation output names
Driver.max_plot_depth               = -1                  ## Restrict maximum plot depth (-1 => finest simulation level)
Driver.max_chk_depth                = -1                  ## Restrict checkpoint depth (-1 => finest simulation level)
Driver.num_plot_ghost               = 1                   ## Number of ghost cells to include in plots
Driver.plt_vars                     = 0                   ## 'tags', 'mpi_rank'
Driver.restart                      = 0                   ## Restart step (less or equal to 0 implies fresh simulation)
Driver.allow_coarsening             = false               ## Allows removal of grid levels according to CellTagger
Driver.grow_geo_tags                = 0                   ## How much to grow tags when using geometry-based refinement.
Driver.refine_angles                = 180.                ## Refine cells if angle between elements exceed this value.
Driver.refine_electrodes            = 0                   ## Refine electrode surfaces. -1 => equal to refine_geometry
Driver.refine_dielectrics           = 0                   ## Refine dielectric surfaces. -1 => equal to refine_geometry

# ====================================================================================================
# CdrCTU solver settings
# ====================================================================================================
CdrCTU.seed                     = -1                        ## Seed. Random seed with seed < 0
CdrCTU.bc.x.lo                  = outflow                   ## 'data', 'function', 'wall', or 'outflow'
CdrCTU.bc.x.hi                  = outflow                   ## 'data', 'function', 'wall', or 'outflow'
CdrCTU.bc.y.lo                  = outflow                   ## 'data', 'function', 'wall', or 'outflow'
CdrCTU.bc.y.hi                  = outflow                   ## 'data', 'function', 'wall', or 'outflow'
CdrCTU.bc.z.lo                  = outflow                   ## 'data', 'function', 'wall', or 'outflow'
CdrCTU.bc.z.hi                  = outflow                   ## 'data', 'function', 'wall', or 'outflow'
CdrCTU.slope_limiter            = minmod                    ## Slope limiter. 'none', 'minmod', 'mc', or 'superbee'
CdrCTU.use_ctu                  = true                      ## If true, use CTU. Otherwise it's DTU.
CdrCTU.eb_inflow_state          = true                      ## If true, the EB is an inflow boundary where the flow leaves it (slopes and outgoing face states of cut cells)
CdrCTU.flux_correction          = true                      ## If true, flux-corrected transport keeps the update non-negative
CdrCTU.plt_vars                 = phi vel src dco ebflux    ## Plot variables. Options are 'phi', 'vel', 'dco', 'src'
CdrCTU.plot_mode                = density                   ## Plot densities 'density' or particle numbers ('numbers')
CdrCTU.blend_conservation       = true                      ## Turn on/off blending with nonconservative divergenceo
CdrCTU.which_redistribution     = state                     ## Redistribution type. 'volume', 'state' or 'none' (turned off)
CdrCTU.use_regrid_slopes        = true                      ## Turn on/off slopes when regridding

CdrCTU.solver                    = gmg gmres    ## Solver(s), tried in order. 'gmg', 'gmres', 'bicgstab'. List = fallback chain
CdrCTU.krylov_eps                = 1.E-10       ## Outer Krylov relative residual tolerance (gmres/bicgstab)
CdrCTU.krylov_max_iter           = 50           ## Outer Krylov max iterations (gmres/bicgstab)
CdrCTU.krylov_restart            = 30           ## GMRES restart length (gmres only)
CdrCTU.krylov_vcycles            = 1            ## V-cycles per Krylov preconditioner application
CdrCTU.krylov_retry_interval     = 1            ## Re-probe GMG every N solves while latched to the Krylov fallback (1 = always retry GMG first)
CdrCTU.krylov_reprobe_iters      = 0            ## Re-probe GMG early when the Krylov fallback converges in <= this many iterations (0 = disabled)
CdrCTU.gmg_verbosity             = -1           ## GMG verbosity
CdrCTU.gmg_pre_smooth            = 6            ## Number of relaxations in GMG downsweep
CdrCTU.gmg_post_smooth           = 6            ## Number of relaxations in upsweep
CdrCTU.gmg_bott_smooth           = 6            ## NUmber of relaxations before dropping to bottom solver
CdrCTU.gmg_min_iter              = 5            ## Minimum number of iterations
CdrCTU.gmg_max_iter              = 32           ## Maximum number of iterations
CdrCTU.gmg_exit_tol              = 1.E-8        ## Residue tolerance
CdrCTU.gmg_exit_hang             = 0.2          ## Solver hang
CdrCTU.gmg_min_cells             = 2            ## Bottom drop
CdrCTU.gmg_bottom_solver         = bicgstab     ## Bottom solver type. Valid options are 'simple' and 'bicgstab'
CdrCTU.gmg_cycle                 = vcycle       ## Cycle type. Only 'vcycle' supported for now
CdrCTU.gmg_smoother              = red_black    ## Relaxation type. 'jacobi', 'multi_color', or 'red_black'

# ====================================================================================================
# RoughSphere geometry class options
# ====================================================================================================
RoughSphere.on                    = true         ## Turn on/off geometry
RoughSphere.material              = electrode    ## 'electrode' or 'dielectric'
RoughSphere.live                  = true         ## Live potential or not (for electrode)
RoughSphere.eps                   = 4            ## Set permittivity for dielectric
RoughSphere.radius                = 0.5          ## Sphere radius
RoughSphere.center                = 0 0 0        ## Sphere center
RoughSphere.noise_amplitude       = 0.0          ## Noise amplitude. Zero gives a sphere.
RoughSphere.noise_frequency       = 5 5 5        ## Noise frequency
RoughSphere.noise_persistence     = 0.5          ## Noise persistence
RoughSphere.noise_octaves         = 1            ## Noise octaves
RoughSphere.noise_reseed          = false        ## Reseed noise

# ====================================================================================================
# RefinementBoxTagger class options
# ====================================================================================================
RefinementBoxTagger.verbosity         = -1         ## Class verbosity
RefinementBoxTagger.buffer            = 0          ## Grow tagged cells
RefinementBoxTagger.num_ref_boxes     = 2          ## Number of refinement boxes. 0 gives a single level.
RefinementBoxTagger.ref_box1_lo       = 0 -2 -2    ## Refine the half space x > 0
RefinementBoxTagger.ref_box1_hi       = 2  2 2     ## (edges between cell centers)
RefinementBoxTagger.ref_box1_lvl      = 1          ## to level 1
RefinementBoxTagger.ref_box2_lo       = 0  0 -2    ## Refine the quadrant x > 0, y > 0
RefinementBoxTagger.ref_box2_hi       = 2  2 2     ##
RefinementBoxTagger.ref_box2_lvl      = 2          ## to level 2

# ====================================================================================================
# AdvectionDiffusionStepper class options
# ====================================================================================================
AdvectionDiffusion.verbosity      = -1       ## Verbosity
AdvectionDiffusion.diffusion      = false    ## Turn on/off diffusion
AdvectionDiffusion.advection      = true     ## Turn on/off advection
AdvectionDiffusion.integrator     = imex     ## 'heun' or 'imex'. With diffusion off, 'imex' is explicit CTU advection; 'heun' is unstable at this CFL.
AdvectionDiffusion.debug          = true     ## Print the change of the total mass in each step

# Velocity, diffusion, and CFL. The velocity and initial data are set by main.cpp.
# --------------------------------------------------------------------------------
AdvectionDiffusion.blob_amplitude     = 1.0      ## Blob amplitude (not used)
AdvectionDiffusion.blob_radius        = 0.05     ## Blob radius (not used)
AdvectionDiffusion.blob_center        = 0 0 0    ## Blob center (not used)
AdvectionDiffusion.omega              = 1.0      ## Rotation velocity (not used)
AdvectionDiffusion.diffco             = 0.0      ## Diffusion coefficient

# Time step controls
# ------------------
AdvectionDiffusion.cfl        = 0.9      ## CFL number
AdvectionDiffusion.min_dt     = 0.0      ## Smallest acceptable time step
AdvectionDiffusion.max_dt     = 1.E99    ## Largest acceptable time step

# Cell tagging stuff (not used, RefinementBoxTagger tags)
# --------------------------------------------------------
AdvectionDiffusion.refine_curv     = 0.25    ## Refine if curvature exceeds this
AdvectionDiffusion.refine_magn     = 1E-2    ## Only tag if magnitude eceeds this
AdvectionDiffusion.buffer          = 0       ## Grow tagged cells

# ====================================================================================================
# RadialOutflow test options
# ====================================================================================================
RadialOutflow.initial_data     = uniform    ## 'blob', 'half_space' (phi = 1 for x > 0), or 'uniform' (phi = 1)
RadialOutflow.speed            = 1.0        ## Radial speed
RadialOutflow.blob_center      = 1 0 0      ## Gaussian blob center
RadialOutflow.blob_radius      = 0.25       ## Gaussian blob radius
